# ─── Application ──────────────────────────────────────────────
APP_NAME=boilerplate-api
APP_ENV=local            # local | staging | production
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug          # debug | info | warn | error
LOG_FORMAT=text          # text (dev) | json (prod)

# ─── AWS / DynamoDB (points to the dockerized LocalStack) ────
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMODB_TABLE=boilerplate

# ─── Observability (points to the dockerized OTEL Collector) ─
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=boilerplate-api
