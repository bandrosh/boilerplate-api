# Normalise line endings to LF for source/config; keep the repo consistent
# across Windows/macOS/Linux.
* text=auto eol=lf

*.go     text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
Makefile text eol=lf

# Binaries
*.png binary
*.jpg binary
*.gif binary
